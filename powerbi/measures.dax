// Add each measure separately in Power BI Desktop.
// First, name the imported table: Sessions.
// The revenue column is 1 for purchase and 0 for no purchase.

Sessions = COUNTROWS(Sessions)

Purchase Sessions = SUM(Sessions[revenue])

Conversion Rate = DIVIDE([Purchase Sessions], [Sessions], 0)

Sessions Without Purchase = [Sessions] - [Purchase Sessions]

Average Product Pages = AVERAGE(Sessions[productrelated])

Average Exit Rate = AVERAGE(Sessions[exitrates])

// Format Conversion Rate and Average Exit Rate as percentages.
// For month order: sort Sessions[month] by Sessions[month_order].
// Do not create a money/revenue measure. This dataset has no prices.
